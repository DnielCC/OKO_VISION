{
  "expo": {
    "name": "OKO VISION",
    "slug": "oko-vision-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "okovision",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050A18"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.okovision.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "La cámara se usa para escanear códigos QR de acceso y tomar fotos de vehículos",
        "NSPhotoLibraryUsageDescription": "Accede a la galería para adjuntar fotos a tus vehículos",
        "NSLocationWhenInUseUsageDescription": "Ubicación para registrar dónde accediste al campus",
        "NSFaceIDUsageDescription": "Autenticación biométrica para acceso rápido a la app"
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050A18"
      },
      "package": "com.okovision.mobile",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permite a OKO VISION usar la cámara para escanear QR de acceso.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite adjuntar fotos a tus vehículos."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite acceso con Face ID / Huella."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00F2FF"
        }
      ],
      "expo-asset",
      "expo-font"
    ]
  }
}
